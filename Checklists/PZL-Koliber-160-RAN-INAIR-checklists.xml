            <and>
                <condition>
                    <greater-than>
                        <property>/engines/engine/rpm</property>
                        <value>2150</value>
                    </greater-than>
                </condition>
                <condition>
                    <less-than>
                        <property>/engines/engine/rpm</property>
                        <value>2250</value>
                    </less-than>
                </condition>
            </and>
        </item>
