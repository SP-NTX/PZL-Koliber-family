<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <name>In the Air RAN</name>
    <checklist>
        <title>Climb RAN</title>
        <item>
            <name>Throttle</name>
            <value>2400 RPM</value>
            <view>
                <heading-offset-deg>5.7</heading-offset-deg>
                <pitch-offset-deg>-15.5</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>-0.1</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>97.0</field-of-view>
            </view>
            <marker>
                <x-m>-0.5901</x-m>
                <y-m>0.0694</y-m>
                <z-m>0.5860</z-m>
                <scale>1.0000</scale>
            </marker>
            <and>
                <condition>
                    <greater-than>
                        <property>/engines/engine/rpm</property>
                        <value>2350</value>
                    </greater-than>
                </condition>
                <condition>
                    <less-than>
                        <property>/engines/engine/rpm</property>
                        <value>2450</value>
                    </less-than>
                </condition>
            </and>
        </item>
        <item>
            <name>Engine Temerature</name>
            <value>Check</value>
            <view>
                <heading-offset-deg>3.1</heading-offset-deg>
                <pitch-offset-deg>-11.8</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>0.1</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>56.4</field-of-view>
            </view>

            <marker>
                <x-m>-0.5876</x-m>
                <y-m>0.1388</y-m>
                <z-m>0.5793</z-m>
                <scale>2.1736</scale>
            </marker>
        </item>
        <item>
            <name>Best Angle Vx</name>
            <value>62 KIAS</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>61</value>
                    </greater-than>
                    <less-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>63</value>
                    </less-than>
                </and>
            </condition>
        </item>
        <item>
            <name>Best Regime Vy</name>
            <value>67 KIAS</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>66</value>
                    </greater-than>
                    <less-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>68</value>
                    </less-than>
                </and>
            </condition>
        </item>
    </checklist>
    <checklist>
        <title>Cruise RAN</title>
        <item>
            <name>Throttle</name>
            <value>2200 RPM Average</value>
            <view>
