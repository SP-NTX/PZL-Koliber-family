<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <name>Takeoff RAN</name>
    <checklist>
        <title>Normal Takeoff RAN</title>
        <item>
            <name>Flaps</name>
            <value>Retracted</value>
            <view>
                <heading-offset-deg>342.1</heading-offset-deg>
                <pitch-offset-deg>-60.5</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>-0.3</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>97.0</field-of-view>
            </view>
            <marker>
                <x-m>-0.4843</x-m>
                <y-m>-0.0174</y-m>
                <z-m>0.1364</z-m>
                <scale>1.0000</scale>
            </marker>
            <condition>
                <equals>
                    <property>/controls/flight/flaps</property>
                    <value>0</value>
                </equals>
            </condition>
        </item>
        <item>
            <name>Throttle</name>
            <value>Full</value>
            <view>
                <heading-offset-deg>5.7</heading-offset-deg>
                <pitch-offset-deg>-15.5</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>-0.1</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>97.0</field-of-view>
            </view>
            <marker>
                <x-m>-0.5901</x-m>
                <y-m>0.0694</y-m>
                <z-m>0.5860</z-m>
                <scale>1.0000</scale>
            </marker>
            <condition>
                <greater-than>
                    <property>/engines/engine/rpm</property>
                    <value>2300</value>
                </greater-than>
            </condition>
        </item>
        <item>
            <name>42 KIAS</name>
            <value>Nose Up</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>41.99</value>
                    </greater-than>
                    <greater-than>
                        <property>/orientation/pitch-deg</property>
                        <value>0</value>
                    </greater-than>
                </and>
            </condition>
        </item>
        <item>
            <name>55 KIAS</name>
            <value>Rotate</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>54.99</value>
                    </greater-than>
                    <greater-than>
                        <property>/position/altitude-agl-ft</property>
                        <value>5</value>
                    </greater-than>
                </and>
            </condition>
        </item>
        <item>
            <name>500' AGL</name>
            <value>Reduce Throttle &amp; Fuel Pump Off</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/position/altitude-agl-ft</property>
                        <value>499</value>
                    </greater-than>
                    <less-than>
                        <property>/switches/fuelpump/</property>
                        <value>1</value>
                    </less-than>
                    <less-than>
                        <property>/engines/engine/rpm</property>
                        <value>2800</value>
                    </less-than>
                </and>
            </condition>
        </item>
    </checklist>
    <checklist>
        <title>Short Field Takeoff RAN</title>
        <item>
            <name>Flaps</name>
            <value>Full</value>
            <view>
                <heading-offset-deg>342.1</heading-offset-deg>
                <pitch-offset-deg>-60.5</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>-0.3</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>97.0</field-of-view>
            </view>
            <marker>
                <x-m>-0.4843</x-m>
                <y-m>-0.0174</y-m>
                <z-m>0.1364</z-m>
                <scale>1.0000</scale>
            </marker>
            <condition>
                <equals>
                    <property>/controls/flight/flaps</property>
                    <value>1</value>
                </equals>
            </condition>
        </item>
        <item>
            <name>Controls</name>
            <value>Full Backwards</value>
            <condition>
                <equals>
                    <property>/controls/flight/elevator</property>
                    <value>-1</value>
                </equals>
            </condition>
        </item>
        <item>
            <name>Throttle</name>
            <value>Full</value>
            <view>
                <heading-offset-deg>5.7</heading-offset-deg>
                <pitch-offset-deg>-15.5</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>-0.1</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>97.0</field-of-view>
            </view>
            <marker>
                <x-m>-0.5901</x-m>
                <y-m>0.0694</y-m>
                <z-m>0.5860</z-m>
                <scale>1.0000</scale>
            </marker>
            <condition>
                <greater-than>
                    <property>/engines/engine/rpm</property>
                    <value>2300</value>
                </greater-than>
            </condition>
        </item>
        <item>
            <name>Rotate</name>
            <value>ASAP</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>41.99</value>
                    </greater-than>
                    <greater-than>
                        <property>/orientation/pitch-deg</property>
                        <value>0</value>
                    </greater-than>
                </and>
            </condition>
        </item>
        <item>
            <name>Flaps</name>
            <value>Retract while accelerating</value>
            <view>
                <heading-offset-deg>342.1</heading-offset-deg>
                <pitch-offset-deg>-60.5</pitch-offset-deg>
                <roll-offset-deg>0.0</roll-offset-deg>
                <x-offset-m>-0.3</x-offset-m>
                <y-offset-m>0.7</y-offset-m>
                <z-offset-m>-0.0</z-offset-m>
                <field-of-view>97.0</field-of-view>
            </view>
            <marker>
                <x-m>-0.4843</x-m>
                <y-m>-0.0174</y-m>
                <z-m>0.1364</z-m>
                <scale>1.0000</scale>
            </marker>
            <condition>
                <equals>
                    <property>/controls/flight/flaps</property>
                    <value>0</value>
                </equals>
            </condition>
        </item>
        <item>
            <name>Initial Ascent Speed</name>
            <value>Vx 62 KIAS</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>61</value>
                    </greater-than>
                    <less-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>63</value>
                    </less-than>
                </and>
            </condition>
        </item>
        <item>
            <name>Over Obstacle</name>
            <value>Vy 67 KIAS</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>66</value>
                    </greater-than>
                    <less-than>
                        <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                        <value>68</value>
                    </less-than>
                </and>
            </condition>
        </item>
        <item>
            <name>500' AGL</name>
            <value>Reduce Throttle &amp; Fuel Pump Off</value>
            <condition>
                <and>
                    <greater-than>
                        <property>/position/altitude-agl-ft</property>
                        <value>499</value>
                    </greater-than>
                    <less-than>
                        <property>/switches/fuelpump/</property>
                        <value>1</value>
                    </less-than>
                    <less-than>
                        <property>/engines/engine/rpm</property>
                        <value>2800</value>
                    </less-than>
                </and>
            </condition>
        </item>
    </checklist>
</PropertyList>